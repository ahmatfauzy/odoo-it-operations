<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep Helpdesk roles separate from generic internal users.  The manager
         role implies the agent role, so every manager gets the operational
         permissions as well as the configuration permissions. -->
    <record id="module_category_helpdesk" model="ir.module.category">
        <field name="name">Helpdesk</field>
        <field name="description">Helpdesk ticket management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Helpdesk User</field>
        <field name="category_id" ref="module_category_helpdesk"/>
        <field name="comment">Can work on tickets assigned to them or their teams.</field>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Manager</field>
        <field name="category_id" ref="module_category_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="comment">Can manage all tickets and Helpdesk configuration.</field>
    </record>

    <!-- An agent sees tickets assigned to them or belonging to one of their
         teams.  This is deliberately an OR: unassigned tickets are not
         visible to agents, while managers get the unrestricted rule below. -->
    <record id="rule_helpdesk_ticket_user" model="ir.rule">
        <field name="name">Helpdesk tickets: assigned user or team member</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.member_ids', 'in', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_helpdesk_ticket_manager" model="ir.rule">
        <field name="name">Helpdesk tickets: manager access</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Agents need to read reference/configuration data used by ticket
         forms, but only managers may change it. -->
    <record id="rule_helpdesk_stage_user" model="ir.rule">
        <field name="name">Helpdesk stages: read for users</field>
        <field name="model_id" ref="model_helpdesk_stage"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_helpdesk_team_user" model="ir.rule">
        <field name="name">Helpdesk teams: read for users</field>
        <field name="model_id" ref="model_helpdesk_team"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_helpdesk_tag_user" model="ir.rule">
        <field name="name">Helpdesk tags: read for users</field>
        <field name="model_id" ref="model_helpdesk_tag"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Managers retain unrestricted configuration access. -->
    <record id="rule_helpdesk_stage_manager" model="ir.rule">
        <field name="name">Helpdesk stages: manager access</field>
        <field name="model_id" ref="model_helpdesk_stage"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_helpdesk_team_manager" model="ir.rule">
        <field name="name">Helpdesk teams: manager access</field>
        <field name="model_id" ref="model_helpdesk_team"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_helpdesk_tag_manager" model="ir.rule">
        <field name="name">Helpdesk tags: manager access</field>
        <field name="model_id" ref="model_helpdesk_tag"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
