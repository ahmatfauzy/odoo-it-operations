<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" records_draggable="true">
                <field name="stage_id"/>
                <field name="name"/>
                <field name="kanban_state"/>
                <field name="priority"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <article class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="ticket_ref"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_title"><field name="name"/></div>
                            <div><field name="partner_id"/></div>
                            <div t-if="record.is_overdue.raw_value" class="text-danger fw-bold">Overdue</div>
                            <footer>
                                <field name="kanban_state" widget="state_selection"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </footer>
                        </article>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_ticket_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-danger="is_overdue" decoration-warning="priority == '2'" decoration-bf="priority == '3'">
                <field name="ticket_ref"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority"/>
                <field name="sla_deadline"/>
                <field name="is_overdue" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,resolved,closed,cancelled" readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Ticket title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_ref"/>
                            <field name="partner_id"/>
                            <field name="team_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="stage_id" options="{'no_create': True}"/>
                            <field name="priority" widget="priority"/>
                            <field name="kanban_state"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <field name="tag_ids" widget="many2many_tags" placeholder="Add tags..."/>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the issue, symptoms, and expected outcome..." nolabel="1"/>
                        </page>
                        <page string="SLA" name="sla">
                            <group string="Service Level">
                                <field name="sla_deadline" help="The target date and time for resolving this ticket."/>
                                <field name="is_overdue" readonly="1"/>
                                <field name="age" readonly="1"/>
                                <field name="close_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="Activity" name="activity">
                            <field name="activity_ids" widget="list_activity"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="kanban_state"/>
                <filter name="my_tickets" string="My Tickets" domain="[('user_id', '=', uid)]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <filter name="priority_high" string="High Priority" domain="[('priority', 'in', ['2', '3'])]"/>
                <filter name="kanban_blocked" string="Blocked" domain="[('kanban_state', '=', 'blocked')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                <group string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_user" string="Assigned User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="group_kanban_state" string="Kanban State" context="{'group_by': 'kanban_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first helpdesk ticket</p>
        </field>
    </record>

    <record id="helpdesk_stage_view_list" model="ir.ui.view">
        <field name="name">helpdesk.stage.list</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <list string="Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="is_close"/>
                <field name="ticket_count"/>
            </list>
        </field>
    </record>
    <record id="helpdesk_stage_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.form</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet><group>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="fold"/>
                    <field name="is_close"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="helpdesk_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">helpdesk.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="helpdesk_team_view_list" model="ir.ui.view">
        <field name="name">helpdesk.team.list</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Teams"><field name="name"/><field name="member_ids" widget="many2many_tags"/><field name="ticket_count"/></list>
        </field>
    </record>
    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Team"><sheet><group><field name="name"/><field name="member_ids" widget="many2many_tags"/><field name="alias_id"/></group></sheet></form>
        </field>
    </record>
    <record id="helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="helpdesk_tag_view_list" model="ir.ui.view">
        <field name="name">helpdesk.tag.list</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <list string="Tags"><field name="name"/><field name="color"/></list>
        </field>
    </record>
    <record id="helpdesk_tag_view_form" model="ir.ui.view">
        <field name="name">helpdesk.tag.form</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <form string="Tag"><sheet><group><field name="name"/><field name="color"/></group></sheet></form>
        </field>
    </record>
    <record id="helpdesk_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Safe view inheritance example: expose a customer's ticket count and
         shortcut without changing the standard Contacts workflow. -->
    <record id="res_partner_view_form_inherit_helpdesk" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.helpdesk</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_helpdesk_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                    <field name="helpdesk_ticket_count" widget="statinfo" string="Tickets"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Keep the Odoo administrator visible during onboarding even before a
         Helpdesk role is assigned. This does not grant regular users access;
         model ACLs and the menu groups below still limit ordinary users. -->
    <menuitem id="helpdesk_menu_root" name="Helpdesk" groups="helpdesk.group_helpdesk_user,helpdesk.group_helpdesk_manager,base.group_system" sequence="10"/>
    <menuitem id="helpdesk_ticket_menu" name="Tickets" parent="helpdesk_menu_root" action="helpdesk_ticket_action" groups="helpdesk.group_helpdesk_user,helpdesk.group_helpdesk_manager,base.group_system" sequence="10"/>
    <menuitem id="helpdesk_configuration_menu" name="Configuration" parent="helpdesk_menu_root" groups="helpdesk.group_helpdesk_manager,base.group_system" sequence="90"/>
    <menuitem id="helpdesk_stage_menu" name="Stages" parent="helpdesk_configuration_menu" action="helpdesk_stage_action" groups="helpdesk.group_helpdesk_manager,base.group_system" sequence="10"/>
    <menuitem id="helpdesk_team_menu" name="Teams" parent="helpdesk_configuration_menu" action="helpdesk_team_action" groups="helpdesk.group_helpdesk_manager,base.group_system" sequence="20"/>
    <menuitem id="helpdesk_tag_menu" name="Tags" parent="helpdesk_configuration_menu" action="helpdesk_tag_action" groups="helpdesk.group_helpdesk_manager,base.group_system" sequence="30"/>
</odoo>
