<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="stage_id"/>
                <field name="kanban_state"/>
                <field name="priority"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <article class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="ticket_ref"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div><field name="name"/></div>
                            <div><field name="partner_id"/></div>
                            <footer>
                                <field name="kanban_state" widget="state_selection"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </footer>
                        </article>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_ticket_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-danger="is_overdue">
                <field name="ticket_ref"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority"/>
                <field name="sla_deadline"/>
                <field name="is_overdue" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Ticket title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_ref"/>
                            <field name="partner_id"/>
                            <field name="team_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="stage_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="state"/>
                            <field name="kanban_state"/>
                        </group>
                    </group>
                    <group string="Service Level">
                        <field name="sla_deadline"/>
                        <field name="close_date"/>
                        <field name="is_overdue"/>
                        <field name="age"/>
                    </group>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the issue..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="stage_id"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <group string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_user" string="Assigned User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first helpdesk ticket</p>
        </field>
    </record>

    <record id="helpdesk_stage_view_list" model="ir.ui.view">
        <field name="name">helpdesk.stage.list</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <list string="Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="is_close"/>
                <field name="ticket_count"/>
            </list>
        </field>
    </record>
    <record id="helpdesk_stage_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.form</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet><group>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="fold"/>
                    <field name="is_close"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="helpdesk_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">helpdesk.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="helpdesk_team_view_list" model="ir.ui.view">
        <field name="name">helpdesk.team.list</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Teams"><field name="name"/><field name="member_ids" widget="many2many_tags"/><field name="ticket_count"/></list>
        </field>
    </record>
    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Team"><sheet><group><field name="name"/><field name="member_ids" widget="many2many_tags"/><field name="alias_id"/></group></sheet></form>
        </field>
    </record>
    <record id="helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="helpdesk_tag_view_list" model="ir.ui.view">
        <field name="name">helpdesk.tag.list</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <list string="Tags"><field name="name"/><field name="color"/></list>
        </field>
    </record>
    <record id="helpdesk_tag_view_form" model="ir.ui.view">
        <field name="name">helpdesk.tag.form</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <form string="Tag"><sheet><group><field name="name"/><field name="color"/></group></sheet></form>
        </field>
    </record>
    <record id="helpdesk_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="helpdesk_menu_root" name="Helpdesk" sequence="10"/>
    <menuitem id="helpdesk_ticket_menu" name="Tickets" parent="helpdesk_menu_root" action="helpdesk_ticket_action" sequence="10"/>
    <menuitem id="helpdesk_configuration_menu" name="Configuration" parent="helpdesk_menu_root" sequence="90"/>
    <menuitem id="helpdesk_stage_menu" name="Stages" parent="helpdesk_configuration_menu" action="helpdesk_stage_action" sequence="10"/>
    <menuitem id="helpdesk_team_menu" name="Teams" parent="helpdesk_configuration_menu" action="helpdesk_team_action" sequence="20"/>
    <menuitem id="helpdesk_tag_menu" name="Tags" parent="helpdesk_configuration_menu" action="helpdesk_tag_action" sequence="30"/>
</odoo>
