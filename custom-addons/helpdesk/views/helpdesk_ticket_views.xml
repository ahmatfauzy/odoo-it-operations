<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first helpdesk ticket
            </p>
        </field>
    </record>

    <menuitem id="helpdesk_menu_root" name="Helpdesk" sequence="10"/>
    <menuitem id="helpdesk_ticket_menu" name="Tickets" parent="helpdesk_menu_root"
              action="helpdesk_ticket_action" sequence="10"/>
</odoo>
