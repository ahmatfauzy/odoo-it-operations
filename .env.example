# Copy this file to .env and fill in local/private values.
# Never commit .env.

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-a-strong-password

# Odoo database manager master password
ODOO_ADMIN_PASSWD=replace-with-a-different-strong-password

# Host port
ODOO_PORT=8069
